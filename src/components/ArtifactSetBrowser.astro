---
import { Image } from 'astro:assets';
import { t, type getLocale } from '../utils/i18n';
import type { getArtifactSetBrowserData } from '../utils/artifact-browser';
import Filters from './Filters.astro';
import SortBy from './SortBy.astro';

interface Props {
  data: ReturnType<typeof getArtifactSetBrowserData>;
  locale: ReturnType<typeof getLocale>;
  charactersHref: string;
}

const { data, locale, charactersHref } = Astro.props;
const ui = (id: string) => t(locale, 'ui', id);

const allLabel = t(locale, 'ui', 'All');
const resultsLabel = t(locale, 'ui', 'Results');
const noResultsLabel = t(locale, 'ui', 'No artifact sets found', undefined, false);
const searchByNameLabel = t(locale, 'ui', 'Search by name');
const rarityLabel = t(locale, 'ui', 'Rarity');
const searchLabel = t(locale, 'ui', 'Search');
const tagLabel = t(locale, 'ui', 'Set Effect', undefined, false);
const artifactSetsLabel = t(locale, 'ui', 'Artifacts Sets', undefined, false);
const sortByLabel = t(locale, 'ui', 'Sort by', undefined, false);
const releaseDateLabel = t(locale, 'ui', 'Release date', undefined, false);
const newestLabel = t(locale, 'ui', 'Newest', undefined, false);
const sortOptions = [
  { value: 'name', label: `${artifactSetsLabel} - A-Z` },
  { value: 'release', label: `${releaseDateLabel} - ${newestLabel}` },
];
const previewLabel = t(locale, 'ui', 'Preview', undefined, false);
const mentionedOnLabel = t(locale, 'ui', 'Artifact set mentioned on', undefined, false);
const noMentionsLabel = t(locale, 'ui', 'No artifact set mentions', undefined, false);
const filterFields = [
  {
    type: 'search' as const,
    name: 'search',
    label: searchLabel,
    placeholder: searchByNameLabel,
    fullWidthOnMobile: true,
  },
  {
    type: 'select' as const,
    name: 'rarity',
    label: rarityLabel,
    options: [
      { value: '', label: allLabel },
      ...data.rarities.map((rarity) => ({
        value: String(rarity),
        label: `${rarity}\u2605`,
      })),
    ],
  },
  {
    type: 'select' as const,
    name: 'tagGroups',
    label: tagLabel,
    options: [
      { value: '', label: allLabel },
      ...data.tagOptionGroups.map((group) => ({
        label: group.label,
        options: group.options.map((tag) => ({
          value: tag.id,
          label: tag.label,
        })),
      })),
    ],
  },
];
---

<section class="artifact-set-browser" data-artifact-browser>
  <div
    class="roster-panel artifact-roster-bar"
    data-artifact-roster
    data-defaults={JSON.stringify(data.characterDefaults)}
    data-ignored-substats={JSON.stringify(data.ignoredSubstats)}
    data-no-characters={ui('Roster no characters')}
    data-not-needed={ui('Roster not needed')}
    data-label-two={ui('Plan two piece')}
    data-label-four={ui('Plan four piece')}
    data-label-substats-needed={ui('Substats needed')}
    data-label-substats-ignored={ui('Substats can be ignored')}
  >
    <div class="roster-toolbar">
      <p>{ui('Roster selected')} <strong data-roster-count aria-live="polite">0</strong></p>
      <a href={charactersHref}>{ui('Plan edit')}</a>
    </div>
    <div class="roster-toolbar">
      <div class="roster-chips" role="group" aria-label={ui('Roster view')}>
        {[['needed', 'Roster keep'], ['unneeded', 'Roster remove'], ['', 'All']].map(([value, label]) => (
          <button class="roster-button" type="button" data-artifact-view={value} aria-pressed={value === '' ? 'true' : 'false'}>
            {ui(label)} <span data-view-count></span>
          </button>
        ))}
      </div>
      <label class="filter-field filter-sort">
        {ui('Roster stats shown')}
        <select class="filter-select" data-artifact-stat-mode>
          <option value="all">{ui('Roster stats all')}</option>
          <option value="top">{ui('Roster stats top')}</option>
        </select>
      </label>
      <label class="roster-checkbox">
        <input type="checkbox" data-artifact-hide-names /> {ui('Roster hide names')}
      </label>
      <label class="roster-checkbox">
        <input type="checkbox" data-artifact-hide-ranked /> {ui('Roster hide ranked')}
      </label>
    </div>
    <select name="roster" form="artifact-set-filters" data-artifact-roster-filter hidden>
      <option value=""></option>
      <option value="needed"></option>
      <option value="unneeded"></option>
    </select>
  </div>
  <Filters
    id="artifact-set-filters"
    kind="artifact"
    fields={filterFields}
    mobileColumnMinWidth={150}
  />

  <div class="browser-results-header">
    <p data-artifact-count data-results-label={resultsLabel} aria-live="polite">
      {data.artifactSets.length}
      {resultsLabel}
    </p>
    <SortBy label={sortByLabel} form="artifact-set-filters" options={sortOptions} selected="name" />
  </div>

  <div class="browser-grid">
    {
      data.artifactSets.map((artifactSet) => (
        <article
          class="browser-entry"
          data-artifact-card
          data-id={artifactSet.id}
          data-usage-json={JSON.stringify(artifactSet.ownedUsage)}
          data-name={artifactSet.name}
          data-rarity={artifactSet.rarity}
          data-tags={artifactSet.tags.join(' ')}
          data-tag-groups={artifactSet.tagGroups.join(' ')}
          data-version-released={artifactSet.versionReleased}
        >
          <header class="browser-entry-header">
            <div class="browser-entry-title">
              <div class={`image-square-bg browser-entry-image${artifactSet.image ? '' : ' is-empty'}`}>
                {artifactSet.image && (
                  <Image
                    src={artifactSet.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width={72}
                    height={72}
                    densities={[1, 2]}
                  />
                )}
              </div>
              <div>
                <h2>{artifactSet.name}</h2>
              </div>
            </div>
            <span class="browser-entry-rarity">
              {artifactSet.rarity}
              {'\u2605'}
            </span>
          </header>

          <div class="artifact-set-effect">
            {artifactSet.bonuses.map((bonus) => (
              <section class="artifact-set-pieces" aria-label={`${artifactSet.name} ${bonus.label}`}>
                <h3>{bonus.label}</h3>
                <div set:html={bonus.html} />
              </section>
            ))}
          </div>

          <section class="browser-usage" aria-label={`${artifactSet.name} ${mentionedOnLabel}`}>
            <h3 class="browser-usage-title">{mentionedOnLabel}</h3>
            {artifactSet.fourPieceUsage.length > 0 ? (
              <div class="browser-usage-list">
                {artifactSet.fourPieceUsage.map((usage) => (
                  <span class="browser-usage-item">
                    <a
                      class={`browser-usage-chip${usage.popoverHtml ? ' has-preview' : ''}`}
                      href={usage.href}
                      data-rarity={usage.characterRarity}
                      data-wip={usage.isWip}
                      data-usage-popover-html={usage.popoverHtml || undefined}
                    >
                      {(usage.rank || usage.isWip) && (
                        <strong class="usage-rank-number">{usage.isWip ? 'WIP' : usage.rank}</strong>
                      )}
                      <span class="browser-usage-character">{usage.characterName}</span>
                    </a>
                    {usage.popoverHtml && (
                      <button
                        type="button"
                        class="browser-usage-preview"
                        data-rarity={usage.characterRarity}
                        data-wip={usage.isWip}
                        data-usage-preview
                        aria-expanded="false"
                        aria-label={`${previewLabel}: ${usage.characterName}`}
                      >
                        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                          <circle cx="8" cy="8" r="6.2" />
                          <path d="M8 7.2v4" />
                          <path d="M8 4.7v.1" />
                        </svg>
                      </button>
                    )}
                  </span>
                ))}
              </div>
            ) : (
              <p class="browser-usage-empty">{noMentionsLabel}</p>
            )}
          </section>

          <section class="artifact-owned">
            <h3>{ui('Roster owned usage')}</h3>
            <div data-artifact-owned></div>
          </section>
        </article>
      ))
    }
  </div>

  <p class="browser-empty" data-artifact-empty hidden>{noResultsLabel}</p>
</section>

<script>
  import '../scripts/card-filters';
  import '../scripts/artifact-usage-popover';
  import '../scripts/artifact-roster';
</script>
